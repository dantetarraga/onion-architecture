{
  "uid": "smart-parking-overview",
  "title": "Smart Parking - Microservicios",
  "tags": [
    "smart-parking"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
