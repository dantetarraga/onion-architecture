# --- PostgreSQL ---
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=smart_parking
POSTGRES_PORT=5434

# --- Backend (NestJS) ---
DATABASE_URL=postgresql://parking:parking@localhost:5434/smart_parking?schema=public
PORT=3000
JWT_SECRET=change-this-dev-secret-key-min-32-chars
JWT_EXPIRES_IN=8h
# Ventana de tolerancia de reservas (Politica 2). Bajar a 1 para demo en vivo.
RESERVATION_TOLERANCE_MINUTES=20
# Politica 1 (asignacion de cocheras): "default" (primera disponible + sugerencia por distancia)
# o "balanced" (menos usada recientemente + sugerencia por distancia+ocupacion). Cambiar y reiniciar
# el backend para ver el swap sin tocar codigo, demo del valor de Onion Architecture.
SLOT_ASSIGNMENT_STRATEGY=default
CORS_ORIGIN=http://localhost:5173
# --- Login con Google (Firebase Authentication) ---
# Solo se usa para verificar la firma del ID token contra las claves publicas
# de Google (via jose + JWKS remoto): no requiere service account ni ningun
# secreto, solo el projectId (dato publico, visible en la config web de
# Firebase). Debe coincidir con el "projectId" del firebaseConfig del frontend.
FIREBASE_PROJECT_ID=hdlizana

# --- Kafka (cola de notificaciones) ---
# Al levantar con docker-compose.dev.yml (Postgres+Kafka en Docker, backend en el host con
# npm run start:dev), el backend corre fuera de la red de Docker: usa el listener expuesto
# al host (KAFKA_HOST_PORT, 29092 por defecto). El docker-compose.yml de la raiz (backend
# tambien containerizado) sobreescribe esto a "kafka:9092" (listener interno de la red).
KAFKA_BROKERS=localhost:29092
KAFKA_HOST_PORT=29092
KAFKA_CLIENT_ID=smart-parking-backend
# Topico donde se publica el evento de confirmacion de reserva; lo consume el
# servicio externo de notificaciones para enviar el correo al usuario.
KAFKA_NOTIFICATIONS_TOPIC=notifications.email.confirmation

# --- RabbitMQ (cola de solicitudes de reserva) ---
# Rol distinto al de Kafka: Kafka es el bus de eventos de salida (correo de
# confirmacion), RabbitMQ es la cola de trabajo que absorbe las solicitudes.
# POST /reservations solo encola y responde 202; el worker consume la cola y
# ejecuta la reserva. Igual que con Kafka, el backend en el host usa localhost
# y el docker-compose.yml de la raiz lo sobreescribe a "rabbitmq:5672".
RABBITMQ_URL=amqp://parking:parking@localhost:5672
RABBITMQ_USER=parking
RABBITMQ_PASSWORD=parking
RABBITMQ_PORT=5672
# UI de gestion: http://localhost:15672 (mismo usuario/clave de arriba).
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_RESERVATIONS_EXCHANGE=reservations
RABBITMQ_RESERVATIONS_QUEUE=reservations.requests
RABBITMQ_REALTIME_EXCHANGE=realtime.events
# prefetch=1 procesa las solicitudes de a una: elimina la carrera de dos
# usuarios reclamando la misma cochera y hace visible la cola en la demo.
RABBITMQ_PREFETCH=1

# --- notifications-service (consumidor de Kafka -> correo) ---
# En false, el servicio consume el topico y solo loguea el correo que
# hubiera enviado (dry-run), sin llamar al SMTP real.
MAIL_ENABLED=false
MAIL_HOST=mail.motoya.com.pe
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=notificaciones@motoya.com.pe

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
# Config publica del proyecto Firebase (login con Google), debe coincidir con
# FIREBASE_PROJECT_ID de arriba. apiKey de Firebase Web es publico por diseño.
VITE_FIREBASE_API_KEY=AIzaSyBNylqVfSm9_ofvWAlj3DyIgcGncUsR6-k
VITE_FIREBASE_AUTH_DOMAIN=hdlizana.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hdlizana
VITE_FIREBASE_STORAGE_BUCKET=hdlizana.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=149047439285
VITE_FIREBASE_APP_ID=1:149047439285:web:abafa15413f3f48be333fc
