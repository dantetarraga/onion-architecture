# --- Kafka ---
# Fuera de Docker (npm run start:dev en el host): usa el listener expuesto al host.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=notifications-service
KAFKA_NOTIFICATIONS_TOPIC=notifications.email.confirmation
KAFKA_CONSUMER_GROUP=notifications-service

# --- Correo (SMTP) ---
# En false (default), el servicio consume el topico y loguea el correo que
# hubiera enviado sin llamar al SMTP real (dry-run seguro para probar el
# consumo de Kafka sin arriesgar mandar correos).
MAIL_ENABLED=false
MAIL_HOST=mail.motoya.com.pe
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=notificaciones@motoya.com.pe
